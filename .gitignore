# ── Fleet onboarding (luxarch / luxlint) ──────────────────────────────────────
# Site-local Makefile config — the private registry host and any other internal
# value. The UNIVERSAL rule (FLEET-BUILD-DEPLOY-STANDARD): never committed, public
# or private. Makefile.local.example IS committed as the template.
Makefile.local

# Transient canonical configs, emitted by `make lint` / `make format` / `make test`
# from the luxlint image and removed by the same recipe. Never committed — the
# config lives in the image, byte-identical fleet-wide, not in this repo.
.luxlint.mypy.ini
.luxlint.ruff.toml
.luxlint.pytest.ini
.luxlint.gitleaks.toml

# Agent-local settings (not shared config)
.claude/settings.local.json
**/.claude/settings.local.json

# Node (present only if an asset build is ever added)
node_modules/

# Claude Code hook session state (luxarch --emit hooks)
.claude/.hooks-heartbeat
.claude/.luxpm-ledger.json
.claude/settings.json.bak
.claude/.push-hold
